generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id             String         @id @default(cuid())
  email          String         @unique
  name           String?
  emailVerified  DateTime?
  image          String?
  hashedPassword String?
  accounts       Account[]
  sessions       Session[]
  conversations  Conversation[]
  projects       Project[]
  agentTasks     AgentTask[]
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  @@map("users")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Conversation {
  id        String    @id @default(cuid())
  userId    String?
  title     String    @default("New Chat")
  user      User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  Message[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([userId, updatedAt])
  @@map("conversations")
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  role           String
  content        String       @db.Text
  attachments    Attachment[]
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@index([conversationId, createdAt])
  @@map("messages")
}

model Attachment {
  id        String   @id @default(cuid())
  messageId String?
  name      String
  size      Int
  mimeType  String
  content   String   @db.Text
  message   Message? @relation(fields: [messageId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([messageId])
  @@map("attachments")
}

model Project {
  id          String   @id @default(cuid())
  userId      String?
  name        String
  description String?  @db.Text
  status      String   @default("active")
  user        User?    @relation(fields: [userId], references: [id], onDelete: Cascade)
  files       ProjectFile[]
  checkpoints ProjectCheckpoint[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, updatedAt])
  @@map("projects")
}

// =====================
// PHASE 3: AGENT SYSTEM
// =====================

model AgentTask {
  id             String   @id @default(cuid())
  userId         String
  conversationId String?
  goal           String   @db.Text
  status         String   @default("CREATED")
  plan           Json?
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  startedAt      DateTime?
  completedAt    DateTime?

  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  runs      AgentRun[]
  events    AgentEvent[]

  @@index([userId, status])
  @@index([conversationId])
  @@map("agent_tasks")
}

model AgentRun {
  id          String   @id @default(cuid())
  taskId      String
  agentType   String   @default("general")
  status      String   @default("PENDING")
  currentStep Int      @default(0)
  createdAt   DateTime @default(now())
  startedAt   DateTime?
  completedAt DateTime?
  metadata    Json?

  task   AgentTask   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  steps  AgentStep[]
  events AgentEvent[]

  @@index([taskId, status])
  @@map("agent_runs")
}

model AgentStep {
  id          String   @id @default(cuid())
  runId       String
  stepNumber  Int
  type        String
  description String   @db.Text
  status      String   @default("PENDING")
  input       Json?
  output      Json?
  error       String?  @db.Text
  createdAt   DateTime @default(now())
  completedAt DateTime?

  run       AgentRun   @relation(fields: [runId], references: [id], onDelete: Cascade)
  toolCalls ToolCall[]

  @@index([runId, stepNumber])
  @@map("agent_steps")
}

model ToolCall {
  id         String   @id @default(cuid())
  stepId     String
  toolName   String
  input      Json
  output     Json?
  status     String   @default("PENDING")
  error      String?  @db.Text
  durationMs Int?
  createdAt  DateTime @default(now())
  completedAt DateTime?

  step AgentStep @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([stepId])
  @@map("tool_calls")
}

model AgentEvent {
  id        String   @id @default(cuid())
  taskId    String
  runId     String?
  type      String
  payload   Json
  createdAt DateTime @default(now())

  task AgentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  run  AgentRun? @relation(fields: [runId], references: [id], onDelete: Cascade)

  @@index([taskId, createdAt])
  @@map("agent_events")
}

// =====================
// PHASE 4: PROJECT FILESYSTEM
// =====================

model ProjectFile {
  id           String   @id @default(cuid())
  projectId    String
  path         String   // relative path inside project
  content      String   @db.Text
  language     String?  // detected language (ts, js, python, etc.)
  size         Int
  hash         String   // SHA-256 of content
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, path])
  @@index([projectId])
  @@map("project_files")
}

model ProjectCheckpoint {
  id         String   @id @default(cuid())
  projectId  String
  name       String
  description String? @db.Text
  taskId     String?  // which agent task created this
  fileCount  Int      @default(0)
  createdAt  DateTime @default(now())

  project Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  files   CheckpointFile[]

  @@index([projectId, createdAt])
  @@map("project_checkpoints")
}

model CheckpointFile {
  id           String @id @default(cuid())
  checkpointId String
  path         String
  content      String @db.Text
  hash         String

  checkpoint ProjectCheckpoint @relation(fields: [checkpointId], references: [id], onDelete: Cascade)

  @@index([checkpointId])
  @@map("checkpoint_files")
}
